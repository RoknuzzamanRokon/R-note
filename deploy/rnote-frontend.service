[Unit]
Description=R-Note frontend (Next.js)
After=network.target rnote-backend.service

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__/r-note-app
Environment=NODE_ENV=production
ExecStart=__NODE__ node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3035
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
