# DB configuration (host may include the port)
DB_HOST=your-mysql-host:3306
DB_USER=your-user
DB_PASSWORD=your-password
DB_NAME=rnote
# true = encrypted connection. Optional CA file to also verify the certificate:
DB_SSL=true
DB_SSL_CA=

# Server
HOST=0.0.0.0
PORT=8035
# Public address of this backend, used to build uploaded image URLs
PUBLIC_URL=http://localhost:8035
# Frontend addresses allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth: long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_DAYS=30
